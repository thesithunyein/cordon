{
  "name": "cordon-harness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cordon — KeeperHub as the execution layer for Aave V3 positions (Sepolia)",
  "scripts": {
    "guard": "tsx src/guard.ts",
    "campaign": "tsx src/campaign.ts",
    "typecheck": "tsc --noEmit",
    "approve": "tsx scripts/approve-reserve.ts",
    "mint": "tsx scripts/mint-reserve.ts",
    "test": "node --import tsx --test src/*.test.ts src/workflows/*.test.ts",
    "sync:site": "node scripts/sync-public-evidence.mjs",
    "drill": "tsx scripts/drill.ts",
    "workflow:push": "tsx scripts/push-workflow.ts",
    "setup": "tsx scripts/setup.ts",
    "verify": "node scripts/verify-receipts.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  }
}
