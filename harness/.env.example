# Cordon configuration — copy to .env and fill in:
#   cp .env.example .env

# KeeperHub organization API key — create at app.keeperhub.com →
# Settings → Developer → API keys (kh_ prefix). Treat it like a password.
KH_API_KEY=kh_your_key_here

# The Aave V3 position Cordon protects (Ethereum Sepolia, chain 11155111).
# Fund it with Sepolia ETH (gas) + the reserve asset before protecting.
POSITION_ADDRESS=0x0000000000000000000000000000000000000000

# Guardian policy
#   Protect when health factor drops below this (1.0 = liquidation).
HEALTH_FACTOR_THRESHOLD=1.5
#   Asset supplied for the protective top-up. LINK is the proven reserve on
#   the shared Sepolia deployment (USDC's supply cap is full there).
RESERVE=LINK
#   Top-up size in human units of RESERVE (e.g. 5 = 5 LINK).
TOP_UP_AMOUNT=5

# Evidence campaign (npm run campaign)
#   Guard cycles per campaign run (each protect logs a receipt).
CAMPAIGN_ROUNDS=25
#   Re-verify each receipt on-chain after the run (true = slower, stronger).
VERIFY_RECEIPTS=true
#   Escalate the threshold after each execution so every round protects again
#   (used to build the on-chain evidence corpus; set false for real guarding).
CAMPAIGN_ESCALATE=false

# Network (Ethereum Sepolia)
CHAIN_ID=11155111
