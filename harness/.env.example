# KeeperHub API key — create at app.keeperhub.com → Settings → Developer → API keys
# (Organization key, kh_ prefix)
KH_API_KEY=kh_your_key_here

# The position Cordon protects. An Aave V3 account on Ethereum Sepolia.
# Fund it with Sepolia ETH + a faucet asset (USDC/DAI) before running the campaign.
POSITION_ADDRESS=0x0000000000000000000000000000000000000000

# Guardian policy
HEALTH_FACTOR_THRESHOLD=1.5
# Top-up asset for the protective supply (Sepolia USDC by default)
ASSET_ADDRESS=0x94a9D9AC8a22534E3FaCa9F4e7F2E2cf85d5E4C8
# USD-denominated top-up amount, in wei of ASSET_ADDRESS (default: 10 USDC)
TOP_UP_AMOUNT=10000000

# Evidence campaign
CAMPAIGN_ROUNDS=10
# Verify each receipt against a public RPC (true = slower, stronger evidence)
VERIFY_RECEIPTS=true

# Network
CHAIN_ID=11155111